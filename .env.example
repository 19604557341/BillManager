# 环境变量模板（此文件会提交到 git，仅放占位说明，不要填真实密钥）
#
# 用法：复制为项目根目录下的 .env 并填入真实值，.env 已被 .gitignore 排除。
#   copy .env.example .env
#
# 生产 / CI 环境无需 .env，直接设置同名系统环境变量即可，优先级更高。

# 数据库账户名（可选，默认 billmanager）
# 建议使用 bill_manager 库的专用受限账户，不要用 root 直连。
DB_USERNAME=billmanager

# 数据库密码（必填，未设置时应用启动会因占位符无法解析而失败）
DB_PASSWORD=

# ---------------------------------------------------------------------------
# 专用账户的创建方式（用 root 登录 MySQL 后执行，把 '你的密码' 换成强随机密码）
#
#   CREATE USER 'billmanager'@'localhost' IDENTIFIED BY '你的密码';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON bill_manager.* TO 'billmanager'@'localhost';
#
# 只授予 DML 权限即可满足应用运行，无需 DDL 与管理权限。
# ---------------------------------------------------------------------------
